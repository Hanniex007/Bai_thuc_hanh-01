#include <stdio.h>
int main() {
    int n;
    printf("Nhap so luong phan tu n: ");
    scanf("%d", &n);
    int a[n];
    printf("Nhap cac phan tu cua mang");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    int max = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }
    printf("Gia tri lon nhat trong mang la: %d\n", max);
    return 0;
}
