#include <stdio.h>

int main() {
    int n, i, count = 0;
    printf("Nhap vao mot so nguyen duong n: ");
    scanf("%d", &n);

    if (n <= 1) {
        printf("%d khong phai la so nguyen to.\n", n);
        return 0;
    }

    for (i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            count++;
            break;
        }
    }

    if (count == 0)
        printf("%d la so nguyen to.\n", n);
    else
        printf("%d khong phai la so nguyen to.\n", n);

    return 0;
}
